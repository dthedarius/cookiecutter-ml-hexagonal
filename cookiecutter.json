{
    "project_name": "My ML Project",
    "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '_').replace('-', '_') }}",
    "project_description": "A production-grade ML service using hexagonal architecture",
    "author_name": "Your Name",
    "author_email": "you@example.com",
    "python_version": "3.12",
    "ml_task": ["text_classification", "regression", "custom"],
    "model_framework": ["huggingface", "sklearn", "pytorch_custom"],
    "serving_type": ["rest", "rest_with_batch"],
    "include_notebooks": ["no", "yes"],
    "include_auth": ["none", "api_key"],
    "include_monitoring": ["basic", "full"],
    "data_versioning": ["none", "dvc"],
    "include_hyperparameter_tuning": ["no", "optuna"],
    "include_docs_site": ["no", "mkdocs"],
    "ci_provider": ["github_actions", "gitlab_ci"],
    "container_registry": ["none", "ghcr", "dockerhub"],
    "prediction_threshold": "0.5",
    "primary_metric": "f1",
    "target_metric_value": "0.90",
    "_copy_without_render": [
        "*.html"
    ]
}
